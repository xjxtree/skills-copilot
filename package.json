{
  "name": "agent-copilot-workspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.5.1",
  "scripts": {
    "dev": "./script/build_and_run.sh",
    "build": "./script/build_and_run.sh --build-only",
    "dev:macos": "./script/build_and_run.sh",
    "build:macos": "./script/build_and_run.sh --build-only",
    "build:macos:arm64": "./script/build_and_run.sh --build-only --arch arm64",
    "build:macos:x86_64": "./script/build_and_run.sh --build-only --arch x86_64",
    "verify:macos-launch": "./script/build_and_run.sh --verify",
    "generate:app-icon": "./script/generate_app_icon.sh",
    "audit": "pnpm audit:rust && pnpm audit:node",
    "audit:rust": "cargo audit",
    "audit:node": "pnpm audit --audit-level high",
    "check:privacy": "./script/check_privacy.sh",
    "classify:validation-blocker": "node scripts/classify-validation-blocker.mjs",
    "capture:macos-window": "./script/capture_app_window.sh AgentCopilot docs/ui-artifacts/native-macos-shell/completed.png",
    "check:macos": "node scripts/check-macos.mjs",
    "smoke:macos-app": "node scripts/smoke-macos-app.mjs",
    "verify:screenshot-artifacts": "node scripts/verify-screenshot-artifacts.mjs",
    "verify:validation-blockers": "node scripts/verify-validation-blockers.mjs",
    "verify:doc-governance": "node scripts/verify-doc-governance.mjs",
    "verify:macos-native-test-registry": "node scripts/verify-macos-native-test-registry.mjs",
    "verify:js-syntax": "node scripts/verify-js-syntax.mjs",
    "verify:module-size": "node scripts/verify-module-size.mjs",
    "verify:quality-budgets": "pnpm test:quality-budgets",
    "verify:list-completeness": "node scripts/verify-list-completeness.mjs",
    "verify:rust-docs": "cargo doc --workspace --no-deps",
    "verify:service-protocol-drift": "node scripts/verify-service-protocol-drift.mjs",
    "test:list-completeness": "node --test scripts/tests/list-completeness.test.mjs",
    "test:quality-budgets": "node --test scripts/tests/quality-budgets.test.mjs scripts/tests/native-list-benchmark.test.mjs scripts/tests/performance-workflow.test.mjs",
    "test:repository-governance": "node --test scripts/tests/repository-governance.test.mjs",
    "test:service-protocol-effects": "node --test scripts/tests/service-protocol-effects.test.mjs",
    "verify:gate-parity": "pnpm verify:service-protocol-drift && pnpm verify:module-size && pnpm verify:quality-budgets && pnpm verify:list-completeness && pnpm verify:doc-governance && pnpm verify:macos-native-test-registry && pnpm verify:js-syntax && pnpm verify:rust-docs && pnpm verify:validation-blockers && pnpm verify:screenshot-artifacts",
    "benchmark:10k": "node scripts/benchmark-10k.mjs",
    "test:macos-list-model": "node scripts/test-native-list-model.mjs",
    "test:macos-native-models": "bash scripts/test-macos-native-models.sh",
    "test:path-identity": "node --test scripts/tests/path-identity.test.mjs scripts/tests/build-run-path-records.test.mjs",
    "benchmark:macos-list-model": "node scripts/benchmark-native-list-model.mjs",
    "verify:macos-ui-layout": "node scripts/verify-native-ui-layout.mjs"
  },
  "devDependencies": {
    "github-slugger": "2.0.0",
    "mdast-util-from-markdown": "2.0.3"
  }
}
