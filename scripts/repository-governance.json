{
  "schema_version": 1,
  "policy_documents": [
    "README.md",
    "AGENTS.md",
    "CONTRIBUTING.md",
    "docs/README.md",
    "docs/runbooks/macos-app-runbook.md",
    ".github/pull_request_template.md",
    ".github/ISSUE_TEMPLATE/feature_request.md"
  ],
  "required_text": {
    "README.md": ["## What It Does", "## Architecture"],
    "AGENTS.md": ["## Safety Boundaries"],
    "docs/README.md": ["## Product And Architecture", "## Maintenance Rules"]
  },
  "forbidden_patterns": [
    "\\bV\\d+\\.\\d+\\b",
    "MVP\\s*(?:/|\\|)\\s*V1",
    "Current (?:Status|State|Baseline)",
    "Completed baseline",
    "Current phase"
  ],
  "forbidden_paths": [
    "CHANGELOG.md",
    "docs/plans",
    "docs/ui-artifacts",
    "docs/verification"
  ],
  "gate": {
    "script": "verify:gate-parity",
    "members": [
      "verify:service-protocol-drift",
      "verify:module-size",
      "verify:quality-budgets",
      "verify:list-completeness",
      "verify:doc-governance",
      "test:check-macos-cache",
      "test:smoke-options",
      "test:distribution-workflow",
      "verify:js-syntax",
      "verify:rust-docs"
    ]
  }
}
